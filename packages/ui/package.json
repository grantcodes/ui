{
  "name": "@grantcodes/ui",
  "version": "2.18.0",
  "description": "A personal component system built with Lit web components",
  "type": "module",
  "main": "dist/main.js",
  "module": "dist/main.js",
  "types": "dist/main.d.ts",
  "author": "grantcodes",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grantcodes/ui.git"
  },
  "bugs": {
    "url": "https://github.com/grantcodes/ui/issues"
  },
  "homepage": "https://github.com/grantcodes/ui#readme",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "import": "./dist/main.js"
    },
    "./icons": {
      "types": "./dist/icons.d.ts",
      "import": "./dist/icons.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./styles/base.css": {
      "import": "./dist/css/base.css",
      "require": "./dist/css/base.css"
    },
    "./styles/themes/*": {
      "import": "./dist/css/themes/*",
      "require": "./dist/css/themes/*"
    },
    "./styles/focus-ring.css": "./dist/lib/styles/focus-ring.css",
    "./styles/all.css": "./dist/lib/styles/all.css",
    "./components/*": {
      "types": "./dist/components/*",
      "import": "./dist/components/*",
      "require": "./dist/components/*"
    },
    "./css-import-attributes": {
      "types": "./css-import-attributes.d.ts"
    },
    "./vite-plugin": {
      "types": "./dist/vite-plugin-css-import-attributes.d.ts",
      "import": "./dist/vite-plugin-css-import-attributes.js"
    }
  },
  "scripts": {
    "dev": "storybook dev -p 6006",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "cem": "cem analyze --config custom-elements-manifest.config.js --litelement",
    "copy:assets": "node scripts/copy-assets.mjs",
    "tsc": "tsc -p tsconfig.json",
    "build:lib": "run-s cem tsc copy:assets",
    "build": "run-s build:lib build-storybook",
    "watch": "run-p watch:tsc watch:assets",
    "watch:tsc": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "watch:assets": "node scripts/copy-assets.mjs --watch",
    "generate": "plop",
    "fix": "run-s fix:lint",
    "fix:lint": "npx @biomejs/biome format --write src",
    "lint": "npx @biomejs/biome lint src",
    "test:unit": "NODE_ENV=test node --import ./src/test-utils/register-js-to-ts.mjs --import @lit-labs/ssr-dom-shim/register-css-hook.js --test --test-concurrency=1 'src/**/*.test.ts'",
    "test:storybook": "vitest run --project=storybook src/components/badge src/components/dialog src/components/popover",
    "test:types": "tsc -p test/types",
    "test": "run-s build:lib lint test:types test:unit"
  },
  "license": "MIT",
  "dependencies": {
    "@grantcodes/style-dictionary": "workspace:^1.10.2",
    "@lit/react": "^1.0.8",
    "lit": "^3.3.3",
    "lucide-static": "^1.47.0",
    "shiki": "^4.4.3"
  },
  "devDependencies": {
    "@arcmantle/vite-plugin-import-css-sheet": "^1.0.14",
    "@biomejs/biome": "2.5.14",
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@grantcodes/commit": "^2.0.0",
    "@lit-labs/ssr-dom-shim": "^1.6.0",
    "@playwright/test": "^1.63.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-themes": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/web-components-vite": "^10.6.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@vitest/browser-playwright": "^4.1.11",
    "esbuild": "^0.28.2",
    "@wc-toolkit/cem-inheritance": "^1.2.5",
    "@wc-toolkit/cem-sorter": "^1.0.1",
    "@wc-toolkit/cem-validator": "^1.3.0",
    "@wc-toolkit/module-path-resolver": "^1.0.1",
    "@wc-toolkit/storybook-helpers": "^10.7.7",
    "happy-dom": "^20.14.5",
    "npm-run-all2": "^9.0.3",
    "playwright": "^1.63.0",
    "plop": "^4.0.5",
    "react": "^19.3.0",
    "storybook": "^10.6.0",
    "typescript": "5.9.3",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  },
  "files": [
    "dist/**/*",
    "custom-elements.json",
    "css-import-attributes.d.ts",
    "CHANGELOG.md",
    "README.md",
    "LICENCE"
  ],
  "customElements": "custom-elements.json",
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
