{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noImplicitAny": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "skipLibCheck": false
  },
  "include": ["consumer.tsx", "consumer-css.ts"]
}
