---
import Hero from './hero.astro'
import Cards from './cards.astro'
import Text from './text.astro'
import Gallery from './gallery.astro'
import Accordion from './accordion.astro'
import Cta from './cta.astro'
import FeatureList from './feature-list.astro'
import Stats from './stats.astro'
import LogoCloud from './logo-cloud.astro'
import Testimonials from './testimonials.astro'
import Pricing from './pricing.astro'
import Newsletter from './newsletter.astro'
import MediaText from './media-text.astro'
import MapEmbed from './map.astro'
import Countdown from './countdown.astro'

const blocks = {
  hero: Hero,
  text: Text,
  gallery: Gallery,
  accordion: Accordion,
  cards: Cards,
  cta: Cta,
  'feature-list': FeatureList,
  stats: Stats,
  'logo-cloud': LogoCloud,
  testimonials: Testimonials,
  pricing: Pricing,
  newsletter: Newsletter,
  'media-text': MediaText,
  map: MapEmbed,
  countdown: Countdown,
}

interface Block {
  type: keyof typeof blocks
  [key: string]: unknown
}

interface Props {
  block: Block
}

const { block } = Astro.props
// Block fields share their names with each block's props, so the block is spread as-is.
const Component = blocks[block.type] as ((props: Record<string, unknown>) => unknown) | undefined
---

{Component && <Component {...block} />}
